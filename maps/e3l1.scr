	level.flags[coop_spawn2origin] = ( -630 67 121 ) // () : -8
	level.flags[coop_spawn3origin] = ( 346 334 131 ) // () : -28
	level.flags[coop_spawn4origin] = ( 231 302 281 ) // () : -31
	level.flags[coop_spawn5origin] = ( 1085 -272 178 ) // () : 130
	level.flags[coop_spawn6origin] = ( 1425 -312 149 ) // () : 152
	level.flags[coop_spawn7origin] = ( 239 -623 122 ) // () : 58
	level.flags[coop_spawn8origin] = ( -593 -248 193 ) // () : 12
}end

//============================================================
coop_updateSpawn3Courtyard:{
//============================================================
iprintlnbold_noloc("Coop DEV Info: coop_updateSpawn3Courtyard")

	//set master angle, reset possible alternative angles
	level.flags[coop_spawn1angles] = ( 0 343 0 ) 
	for( local.i = 2;local.i<=8;local.i++){
		level.flags["coop_spawn"+local.i+"angles"] = ( 0 0 0 )
	}

	level.flags[coop_spawn1origin] = ( -632 3413 176 ) 
	level.flags[coop_spawn2origin] = ( -592 3413 176 ) 
	level.flags[coop_spawn3origin] = ( -672 3413 176 ) 
	level.flags[coop_spawn4origin] = ( -712 3413 176 ) 
	level.flags[coop_spawn5origin] = ( -712 3363 176 ) 
	level.flags[coop_spawn6origin] = ( -672 3363 176 ) 
	level.flags[coop_spawn7origin] = ( -632 3363 176 ) 
	level.flags[coop_spawn8origin] = ( -592 3363 176 )
	
	level.coop_disableSpawnWarper	= game.false	//chrissstrahl - enable respawn warper
}end

//[206] chrissstrahl - this is called locally
//============================================================
coop_triggerFireDelayed local.trigger local.time:{
//============================================================
	wait local.time
	if(local.trigger){
		trigger local.trigger
	}
}end


//[206] chrissstrahl - this is called locally
//============================================================
coop_triggerCoopification local.targetname:{
//============================================================
	if(local.targetname){
		if($(local.targetname)){
			local.triggersSet = 0
			for (local.i = 1; local.i <= $(local.targetname).size; local.i++) {
				local.trigger = $(local.targetname)[local.i]
				if(local.trigger){
					local.trigger spawnflags 8
					local.triggersSet++
				}
			}
			//println("coop_triggerCoopification "+local.triggersSet+" spawnflags set for "+local.targetname);
		}
	}
}end

//[206] chrissstrahl - this is called locally
//============================================================
coop_missioncomplete:{
//============================================================
	exec global/missioncomplete.scr (level.coopNextMap) 1
}end

