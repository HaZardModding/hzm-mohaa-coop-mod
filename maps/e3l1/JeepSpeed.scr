}end

//=========================================================================
jeepskid: {
//=========================================================================
	self remove
	
	//[206] chrissstrahl - make sure this trigger fires always - even if no player is on the server
	if(level.planecrashtrigger){
		thread maps/e3l1.scr::coop_triggerFireDelayed level.planecrashtrigger 1
	}
	thread maps/e3l1/JeepRidePart3.scr::wakeguybehindcar
	
	$jeep modifydrive 0 200 256
	wait 3

	$jeep stop
	level.rideDone = 1
}end